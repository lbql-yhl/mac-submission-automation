# Paths are optional. Blank values use portable defaults derived from this project and $HOME.
SUBMISSION_PROJECT_ROOT=
SUBMISSION_VM_IMAGES_DIR=
SUBMISSION_VM_TEMPLATE=
SUBMISSION_SHARED_DIR=
SUBMISSION_SSH_PRIVATE_KEY=
SUBMISSION_SSH_PUBLIC_KEY=
PROJECT_SKILLS_DIR=

# Required on each machine. Set this to that machine's exact Feishu registration name.
# Never copy another machine's host identity during migration.
SUBMISSION_HOST_MACHINE=

# Feishu intake creates a Codex App handoff and must not start a background runner.
SUBMISSION_RUNNER_COMMAND=
SUBMISSION_RUNNER_TIMEOUT_SECONDS=21600

# Resolve Codex through PATH; do not copy another host's absolute binary path.
FEISHU_CODEX_COMMAND=codex
FEISHU_CODEX_MODEL=gpt-5.6-sol

# Required only when utm-21 clones the protected Codeup repository.
# Keep values in the local .env; skills and logs must never embed or print them.
CODEUP_USERNAME=
CODEUP_PASSWORD=
